{
  "name": "flac-tagger",
  "version": "2.0.0",
  "description": "Pure JavaScript FLAC Tag writer and reader.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the1812/flac-tagger.git"
  },
  "scripts": {
    "watch": "tsc --watch",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "eslint-check": "eslint . --ext .cjs,.mjs,.ts",
    "lint": "npm-run-all -p type-check eslint-check",
    "eslint-fix": "eslint . --ext .cjs,.mjs,.ts --fix",
    "test-watch": "vitest",
    "test": "vitest run"
  },
  "keywords": [
    "nodejs",
    "metadata",
    "tags",
    "flac",
    "music"
  ],
  "author": "Grant Howard (https://github.com/the1812)",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@the1812/eslint-config": "2.0.0",
    "@types/node": "^24",
    "eslint": "9.39.2",
    "npm-run-all": "4.1.5",
    "prettier": "3.7.4",
    "tsconfig-to-dual-package": "1.2.0",
    "typescript": "~5.8.0",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "imageinfo": "^1.0.4"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
